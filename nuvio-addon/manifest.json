{
  "manifest_version": 3,
  "name": "Nuvio Helper",
  "description": "Addon para Nuvio: mejoras de productividad y utilidades personalizadas.",
  "version": "0.1.0",
  "author": "Tu nombre",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Nuvio Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://nuvioapp.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://nuvioapp.com/*"]
}
